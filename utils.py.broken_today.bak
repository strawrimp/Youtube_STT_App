import google.generativeai as genai
import streamlit as st
import os
import time

# API 키 설정
if "GOOGLE_API_KEY" in st.secrets:
    genai.configure(api_key=st.secrets["GOOGLE_API_KEY"])
else:
    genai.configure(api_key=os.getenv("GOOGLE_API_KEY"))

def get_ai_correction(text):
    """
    AI를 사용하여 텍스트를 교정합니다. (Flash 모델 우선 사용)
    """
    try:
        # 사용 가능한 모델 검색
        available_models = []
        for m in genai.list_models():
            if 'generateContent' in m.supported_generation_methods:
                available_models.append(m.name)
        
        # Flash 모델 우선순위 설정
        priority_models = [m for m in available_models if 'flash' in m.lower()]
        other_models = [m for m in available_models if 'flash' not in m.lower()]
        target_models = priority_models + other_models

        # 모델 순차 시도
        for model_name in target_models:
            try:
                # print(f"DEBUG: Trying AI Model: {model_name}") 
                model = genai.GenerativeModel(model_name)
                
                prompt = (
                    f"다음 텍스트의 오탈자를 수정하고 문맥을 자연스럽게 다듬어줘. "
                    f"절대 '수정본:', '제안:' 같은 사족을 붙이지 말고, 결과 텍스트만 출력해.\n\n"
                    f"텍스트: {text}"
                )
                
                response = model.generate_content(prompt)
                
                if response.text:
                    return response.text.replace("수정본:", "").replace("제안:", "").strip()
            
            except Exception as e:
                if "429" in str(e) or "ResourceExhausted" in str(e):
                    time.sleep(1)
                    continue
                else:
                    continue

        return "AI 서버가 혼잡합니다. 잠시 후 다시 시도해주세요."

    except Exception as final_e:
        return f"AI 연결 오류: {str(final_e)}"

# 👇 [이 함수가 빠져서 에러가 났던 것입니다. 추가했습니다!]
def format_timestamp(seconds):
    """초(Seconds)를 MM:SS 형식의 문자열로 변환합니다."""
    if seconds is None:
        return "00:00"
    minutes = int(seconds // 60)
    seconds = int(seconds % 60)
    return f"{minutes:02}:{seconds:02}"